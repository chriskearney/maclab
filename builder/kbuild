#!/bin/bash
# kbuild: fetch one commit, build it with a given config, emit a maclab kernel artifact.
#
# In:  URL, SHA, LABVER (release suffix) env; /io/config (a .config, e.g. from the target's /proc/config.gz)
# Out: /io/out/{kernel,module-build}.tar.zst, /io/release, /io/kernel
# Keeps /cache bounded: one shared git store, one reused worktree, two build dirs, capped ccache.
set -euo pipefail
: "${URL:?}" "${SHA:?}" "${LABVER:?}"
unset LOCALVERSION  # make appends this env var to the release; ours goes in the config
C=/cache
CCACHE_MAX=${CCACHE_MAX:-8G}
KEEP_BUILDS=${KEEP_BUILDS:-3}
NEED_GB=${NEED_GB:-12} # free space a build starts with: a full object tree is ~9.5 GB
mkdir -p $C/git $C/build $C/ccache $C/tmp
export CCACHE_DIR=$C/ccache CCACHE_COMPILERCHECK=content
# ccache via its gcc wrappers: CC stays one word, which rustc needs as a linker.
export PATH=/usr/lib/ccache:$PATH
ccache -M "$CCACHE_MAX" >/dev/null
step() { echo "==> $*"; echo "@@stage ${1%% *}"; }

# Object trees, least recently used first (by their .last-used stamp), except this build's.
lru_trees() {
  for d in $C/build/*/; do
    [ "$d" = "$O/" ] && continue
    echo "$(stat -c %Y "$d.last-used" 2>/dev/null || echo 0) $d"
  done | sort -n | cut -d' ' -f2
}
free_gb() { df -Pk $C | awk 'NR==2 { print int($4 / 1048576) }'; }

# make_room frees space before a build, not after: a run of failed builds with new
# configs (which never reach "tidy cache") once filled the volume mid-compile.
make_room() {
  local d
  for d in $(lru_trees); do
    [ "$(free_gb)" -ge "$NEED_GB" ] && return
    echo "cache: $(free_gb) GB free, need $NEED_GB; removing the least recently used object tree $(basename "$d")"
    rm -rf "$d"
  done
  if [ "$(free_gb)" -lt "$NEED_GB" ]; then
    echo "cache: still $(free_gb) GB free; emptying ccache"
    ccache -C >/dev/null
  fi
}

step "fetch $URL $SHA"
git -C $C/git rev-parse --git-dir >/dev/null 2>&1 || git init -q --bare $C/git
# Depth-1 fetch of just this commit; objects shared with earlier commits are not re-sent.
if ! git -C $C/git cat-file -e "$SHA^{commit}" 2>/dev/null; then
  auth=()
  # Private github.com repos: lab-builder drops a token in /io for this build only.
  if [ -s /io/github-token ] && [[ $URL == https://github.com/* ]]; then
    auth=(-c "http.https://github.com/.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$(cat /io/github-token)" | base64 -w0)")
  fi
  git "${auth[@]}" -C $C/git fetch -q --depth=1 --no-tags "$URL" "$SHA"
fi
rm -f /io/github-token
git -C $C/git update-ref "refs/lab/$SHA" "$SHA"

step "checkout"
# One worktree reused across builds: only files that differ are rewritten, so make rebuilds little.
export GIT_DIR=$C/git GIT_WORK_TREE=$C/src
mkdir -p $C/src
git checkout -q --force --detach "$SHA"
git clean -q -f -d -x
unset GIT_DIR GIT_WORK_TREE
cd $C/src

cfghash=$(sha256sum /io/config | cut -c1-12)
O=$C/build/$cfghash
mkdir -p "$O"
touch "$O/.last-used"
make_room
cp /io/config "$O/.config"
./scripts/config --file "$O/.config" --set-str LOCALVERSION "$LABVER" -d LOCALVERSION_AUTO
if [ -f rust-toolchain.toml ]; then export RUSTUP_TOOLCHAIN=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml); fi

step "configure"
make -s O="$O" olddefconfig
make -s O="$O" rustavailable >/dev/null 2>&1 && echo "rust: available ($(rustc --version))" || echo "rust: not available"

step "build ($(nproc) cpus)"
start=$(date +%s)
# Progress: objects built so far against the count from the last full build of this config.
total=$(cat "$O/.objcount" 2>/dev/null || cat $C/.objcount 2>/dev/null || echo 0)
( while sleep 4; do echo "@@progress $(find "$O" -name '*.o' -newer "$O/.last-used" 2>/dev/null | wc -l) $total"; done ) &
ticker=$!
trap 'kill $ticker 2>/dev/null || true' EXIT
# -s: no per-file lines, but every warning and error still shows.
make -s O="$O" -j"$(nproc)" Image modules dtbs || { echo "build failed"; exit 1; }
kill $ticker 2>/dev/null || true
n=$(find "$O" -name '*.o' | wc -l); echo "$n" > "$O/.objcount"; echo "$n" > $C/.objcount
echo "@@progress $n $n"
echo "build: $(( $(date +%s) - start ))s"
# Read the release only after building: make refreshes it during prepare.
krel=$(make -s O="$O" kernelrelease)
echo "release: $krel"
case "$krel" in *"$LABVER") ;; *) echo "release $krel does not end in $LABVER"; exit 1 ;; esac

step "package"
P=$C/tmp/pkg
rm -rf "$P"
mkdir -p "$P/usr"
make -s O="$O" INSTALL_MOD_PATH="$P/usr" INSTALL_MOD_STRIP=1 modules_install
M=$P/usr/lib/modules/$krel
rm -f "$M/build" "$M/source"
cp "$O/arch/arm64/boot/Image" "$M/vmlinuz"
make -s O="$O" INSTALL_DTBS_PATH="$M/dtbs" dtbs_install
python3 /usr/local/bin/module-build.py "$C/src" "$O" /io "$C/git"
tar -C "$P" --zstd -cf /io/out/kernel.tar.zst usr
echo kernel.tar.zst > /io/kernel
echo "$krel" > /io/release
rm -rf "$P"
echo "artifact: $(du -h /io/out/kernel.tar.zst | cut -f1)"

step "tidy cache"
lru_trees | head -n -$((KEEP_BUILDS - 1)) | xargs -r rm -rf
for r in $(git -C $C/git for-each-ref --format='%(refname)' refs/lab/ | head -n -8); do git -C $C/git update-ref -d "$r"; done
if [ $(( RANDOM % 5 )) -eq 0 ]; then git -C $C/git gc -q --prune=now; fi
ccache -s | grep -E -i "cache size|hit rate" || true
df -h $C | tail -1
exit 0
