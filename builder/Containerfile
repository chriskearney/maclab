# maclab kernel builder: runs in an Apple `container` micro-VM on the controller Mac.
# Toolchain mirrors the linux-aurora PKGBUILD: gcc, rustc pinned by rust-toolchain.toml,
# bindgen, pahole, dtc. Everything that persists lives on the /cache volume.
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential bc bison flex libelf-dev libssl-dev dwarves cpio kmod python3 perl \
      git ca-certificates curl ccache zstd xz-utils device-tree-compiler rsync \
      clang libclang-dev lld llvm bindgen \
  && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain 1.93.1 --component rust-src --component rustfmt \
  && rustc --version && bindgen --version
COPY kbuild /usr/local/bin/kbuild
COPY module-build.py /usr/local/bin/module-build.py
ENTRYPOINT ["/usr/local/bin/kbuild"]
