# systemd user unit: cp to ~/.config/systemd/user/ and `systemctl --user enable --now labd`
# (run `loginctl enable-linger $USER` so it keeps running when you log out)
[Unit]
Description=maclab controller
After=network-online.target

[Service]
ExecStart=%h/.local/bin/labd --listen :7770
Restart=always
RestartSec=3
# The first start makes $USER the first Maintainer; add --maintainer <name> to ExecStart for someone else.
# Environment=MACLAB_NTFY=https://ntfy.sh/<secret-topic>
# Environment=MACLAB_NOTIFY_CMD=notify-send -u critical "$MACLAB_TITLE" "$MACLAB_BODY"

[Install]
WantedBy=default.target
