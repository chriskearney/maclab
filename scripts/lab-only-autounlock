#!/bin/bash
# lab-only-autounlock: let a lab-only Omarchy Mac with an encrypted root boot without the disk
# passphrase, so lab-agent can reboot it unattended. For Lab-owned Macs, fresh lab-only installs
# with nothing personal on them, and a lab-only install a Volunteer lends the lab with their
# explicit agreement. See docs/encrypted-macs.md.
#
#   sudo scripts/lab-only-autounlock status          what is set up now (changes nothing)
#   sudo scripts/lab-only-autounlock enable [--yes]  add a key slot, put its key in the boot images
#   sudo scripts/lab-only-autounlock disable [--yes] remove the key slot first, then everything else
#
# WHILE IT IS ENABLED, ANYONE WHO HOLDS THE MAC CAN READ ITS DISK: the key is inside the boot
# images on the unencrypted EFI partition. enable and disable ask you to type "yes" (--yes answers
# for you); cryptsetup asks for the disk passphrase on the terminal either way.
#
# enable: a random 64-byte key in /etc/cryptsetup-keys.d/<volume>.key, a LUKS2 key slot for it
# (pbkdf2, 1000 iterations: it is random, so a slow KDF buys nothing), FILES+=(<key>) in a
# mkinitcpio drop-in, rd.luks.key=<uuid>=<key> on the kernel command line, and a rebuild of the
# boot images. It then checks every boot image and boot entry has it and the key opens the volume.
# disable: removes the key slot first (with the key file, or with the key copied out of a boot
# image when the key file is gone), so the copies left on this Mac open nothing; then the key
# file, the drop-in and the cmdline argument, rebuilds and checks. It can't undo what someone who
# had the Mac while it was enabled may have kept: the volume key never changes.
set -euo pipefail
export LC_ALL=C

PROG=lab-only-autounlock
DROPIN=/etc/mkinitcpio.conf.d/99-lab-only-autounlock.conf
KEYDIR=/etc/cryptsetup-keys.d
STATE=/boot/omarchy/encrypt.state # Omarchy Mac: the owner's and recovery key slots
LIMINE=/etc/default/limine
GRUB=/etc/default/grub
CRYPTTAB=/etc/crypttab.initramfs
BACKUPS=/root/lab-only-autounlock-backups
TMPD=

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

# A private folder for keys copied out of boot images; shredded on exit.
cleanup() {
	[[ -n $TMPD && -d $TMPD ]] || return 0
	find "$TMPD" -type f -exec shred -u -- {} + 2>/dev/null || true
	rm -rf -- "$TMPD"
}
trap cleanup EXIT

make_tmpd() {
	[[ -n $TMPD ]] && return 0
	TMPD=$(mktemp -d "/run/$PROG.XXXXXX") || die "couldn't make a private folder in /run"
	chmod 700 "$TMPD"
}

# ---- the layout this supports ----------------------------------------------------------------

limine_value() {
	local line
	line=$(grep -E "^[[:space:]]*$1=" "$LIMINE" | tail -1) || return 0
	line=${line#*=}
	line=${line%\"}; line=${line#\"}; line=${line%\'}; line=${line#\'}
	printf '%s' "$line"
}

effective_hooks() {
	# The HOOKS mkinitcpio will use: its config and drop-ins, sourced in the same order.
	# shellcheck disable=SC1090,SC1091
	bash -c 'source /etc/mkinitcpio.conf; for f in /etc/mkinitcpio.conf.d/*.conf; do [[ -e $f ]] && source "$f"; done; printf "%s\n" "${HOOKS[@]}"' 2>/dev/null
}

keyslots() {
	local dump
	dump=$(cryptsetup luksDump "$DEVICE") || die "couldn't read the LUKS header of $DEVICE"
	awk '/^[^ \t]/ { k = ($0 == "Keyslots:") } k && /^ +[0-9]+: luks2/ { sub(":", "", $1); print $1 }' <<<"$dump"
}

# Sets PBKDF2_SLOTS to the key slots made the way this script makes them (pbkdf2, 1000
# iterations). A passphrase slot gets argon2id, or pbkdf2 with a benchmarked iteration count far
# above 1000, so these are how to tell an auto-unlock slot whose key is gone.
pbkdf2_slots() {
	local dump
	dump=$(cryptsetup luksDump "$DEVICE") || die "couldn't read the LUKS header of $DEVICE"
	mapfile -t PBKDF2_SLOTS < <(awk '
		/^[^ \t]/ { k = ($0 == "Keyslots:"); next }
		!k { next }
		/^ +[0-9]+: luks2/ { s = $1; sub(":", "", s); p[s] = ""; it[s] = ""; next }
		$1 == "PBKDF:" { p[s] = $2 }
		$1 == "Iterations:" { it[s] = $2 }
		END { for (x in p) if (p[x] == "pbkdf2" && it[x] == "1000") print x }
	' <<<"$dump" | sort -n)
}

# Sets ORPHANS to the pbkdf2/1000 slots that are neither kept nor among the slots given.
orphan_slots() {
	local s
	ORPHANS=()
	pbkdf2_slots
	for s in "${PBKDF2_SLOTS[@]}"; do
		kept "$s" && continue
		[[ " $* " == *" $s "* ]] && continue
		ORPHANS+=("$s")
	done
}

state_value() { awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$STATE"; }

# Sets UUID, VOLUME, DEVICE, KEY, TOKEN, MODE, CMDFILE, CMDLINE_RE, REBUILD, ESP, UKI_NAME,
# LIMINE_CONF, KEEP.
check_layout() {
	local args hooks root state_uuid slots s owner recovery c
	mapfile -t args < <(tr ' ' '\n' </proc/cmdline | grep -E '^rd\.luks\.(name|uuid)=' || true)
	(( ${#args[@]} == 1 )) || die "expected exactly one rd.luks.name= or rd.luks.uuid= on the kernel command line, found ${#args[@]}; this needs a LUKS2 root that the systemd initramfs unlocks"
	case ${args[0]} in
		rd.luks.name=*)
			args[0]=${args[0]#rd.luks.name=}
			UUID=${args[0]%%=*}
			VOLUME=${args[0]#*=} ;;
		rd.luks.uuid=*)
			UUID=${args[0]#rd.luks.uuid=}
			UUID=${UUID#luks-}
			VOLUME=luks-$UUID ;;
	esac
	[[ $UUID =~ ^[0-9a-fA-F-]{36}$ ]] || die "unexpected LUKS UUID on the kernel command line: $UUID"
	[[ $VOLUME =~ ^[A-Za-z0-9_-]+$ ]] || die "unexpected volume name on the kernel command line: $VOLUME"
	[[ -e /dev/disk/by-uuid/$UUID ]] || die "no disk with LUKS UUID $UUID"
	DEVICE=$(readlink -f "/dev/disk/by-uuid/$UUID")
	cryptsetup isLuks --type luks2 "$DEVICE" || die "$DEVICE isn't LUKS2"
	[[ -e /dev/mapper/$VOLUME ]] || die "/dev/mapper/$VOLUME isn't open"
	root=$(findmnt -no SOURCE /) || die "can't tell what / is mounted from"
	root=${root%%\[*}
	[[ $(readlink -f "$root") == "$(readlink -f "/dev/mapper/$VOLUME")" ]] || die "/ is on $root, not on /dev/mapper/$VOLUME; this only handles the root volume"
	KEY=$KEYDIR/$VOLUME.key
	TOKEN=rd.luks.key=$UUID=$KEY

	hooks=$(effective_hooks)
	grep -qx systemd <<<"$hooks" || die "the initramfs isn't systemd-based (no systemd hook in HOOKS)"
	grep -qx sd-encrypt <<<"$hooks" || die "the initramfs has no sd-encrypt hook"
	! grep -qx encrypt <<<"$hooks" || die "the initramfs uses the busybox encrypt hook, which reads neither rd.luks.key nor $KEYDIR"

	# Where the kernel command line comes from. On an Omarchy Mac (the omarchy-mac tools are
	# there), omarchy-mac-limine-cmdline derives Limine's KERNEL_CMDLINE from GRUB_CMDLINE_LINUX in
	# /etc/default/grub at every rebuild: an edit to /etc/default/limine never reaches limine.conf.
	[[ -r $LIMINE ]] || die "no $LIMINE: this handles Limine with UKIs only"
	if command -v omarchy-mac-limine-cmdline >/dev/null || command -v omarchy-mac-boot-update >/dev/null; then
		command -v omarchy-mac-limine-cmdline >/dev/null && command -v omarchy-mac-boot-update >/dev/null ||
			die "this looks like an Omarchy Mac, but omarchy-mac-limine-cmdline or omarchy-mac-boot-update is missing; not guessing where the kernel command line comes from"
		[[ -f $GRUB ]] || die "this is an Omarchy Mac, but there is no $GRUB: omarchy-mac-limine-cmdline takes the kernel command line from GRUB_CMDLINE_LINUX there, and an edit to $LIMINE wouldn't reach limine.conf. Put GRUB_CMDLINE_LINUX back (see omarchy-mac-limine-cmdline), then run this again"
		omarchy-mac-limine-active || die "this Mac doesn't boot Limine (omarchy-mac-limine-active); this handles Limine with UKIs only"
		MODE=omarchy-mac CMDFILE=$GRUB CMDLINE_RE='^GRUB_CMDLINE_LINUX=' REBUILD=omarchy-mac-boot-update
	else
		command -v limine-update >/dev/null || die "no limine-update to rebuild the boot images"
		grep -qE '^KERNEL_CMDLINE\[default\]\+?=' "$LIMINE" || die "$LIMINE has no KERNEL_CMDLINE[default] line to add rd.luks.key to"
		MODE=limine CMDFILE=$LIMINE CMDLINE_RE='^KERNEL_CMDLINE\[default\]\+?=' REBUILD=limine-update
	fi
	[[ $(limine_value ENABLE_UKI) == yes ]] || die "$LIMINE doesn't set ENABLE_UKI=yes"
	UKI_NAME=$(limine_value CUSTOM_UKI_NAME)
	[[ $UKI_NAME =~ ^[a-z0-9]+$ ]] || die "$LIMINE has no CUSTOM_UKI_NAME that Limine would use"
	ESP=$(limine_value ESP_PATH)
	[[ -n $ESP && -d $ESP/EFI/Linux ]] || die "ESP_PATH ($ESP) in $LIMINE has no EFI/Linux folder"
	command -v objcopy >/dev/null || die "reading a UKI needs objcopy (binutils)"
	command -v lsinitcpio >/dev/null || die "no lsinitcpio to read the boot images"
	# The limine.conf Limine reads: the first of its own search paths on the ESP.
	LIMINE_CONF=
	for c in EFI/BOOT/limine.conf boot/limine/limine.conf boot/limine.conf limine/limine.conf limine.conf; do
		[[ -f $ESP/$c ]] && { LIMINE_CONF=$ESP/$c; break; }
	done

	# Slots this never touches: the owner's and recovery key's, where encrypt.state records them.
	KEEP=()
	[[ -r $STATE ]] || return 0
	state_uuid=$(state_value luks_uuid)
	[[ ${state_uuid,,} == "${UUID,,}" ]] || die "$STATE is for LUKS $state_uuid, not $UUID"
	owner=$(state_value owner_slot)
	recovery=$(state_value recovery_slot)
	[[ $owner =~ ^([0-9]|[12][0-9]|3[01])$ ]] || die "$STATE has no usable owner_slot"
	[[ -z $recovery || $recovery =~ ^([0-9]|[12][0-9]|3[01])$ ]] || die "$STATE has an unusable recovery_slot"
	KEEP=("$owner"); [[ -z $recovery ]] || KEEP+=("$recovery")
	slots=$(keyslots)
	for s in "${KEEP[@]}"; do
		grep -qx "$s" <<<"$slots" || die "the LUKS header has no key in slot $s, which $STATE records; not touching anything"
	done
}

kept() { local s; for s in "${KEEP[@]}"; do [[ $1 == "$s" ]] && return 0; done; return 1; }

# Sets PROBED to the slot key file $1 opens, or empty when it opens none (or doesn't exist). Any
# other cryptsetup failure stops the script: never guess "not enrolled".
probe_file() {
	local out status=0
	PROBED=
	[[ -f $1 ]] || return 0
	out=$(cryptsetup open --test-passphrase --verbose --token-type passphrase-only --key-file "$1" "$DEVICE" 2>&1) || status=$?
	case $status in
		0) PROBED=$(grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1) || true
		   [[ -n $PROBED ]] || die "cryptsetup opened the disk with $1 but didn't say which slot" ;;
		2) ;;
		*) die "couldn't check $1 against $DEVICE (cryptsetup exit $status): ${out##*$'\n'}" ;;
	esac
}

# Sets KEY_SLOT to the slot the key file opens, or empty when it opens none (or there is no key
# file).
probe_key() { probe_file "$KEY"; KEY_SLOT=$PROBED; }

refuse_kept() {
	[[ -n $KEY_SLOT ]] && kept "$KEY_SLOT" || return 0
	die "the key file opens key slot $KEY_SLOT, which $STATE records as the owner's or recovery slot. Either encrypt.state is stale or this isn't this script's key; nothing changed."
}

ukis() {
	local f
	shopt -s nullglob
	for f in "$ESP/EFI/Linux/${UKI_NAME}"_*.efi; do printf '%s\n' "$f"; done
	shopt -u nullglob
}

initramfs_images() {
	local f
	for f in /boot/initramfs-*.img; do [[ -f $f ]] && printf '%s\n' "$f"; done
	return 0
}

# The test kernels lab-agent stages as UKIs under <esp>/maclab/<job>/. They are built from this
# Mac's initramfs, so they hold the key too; lab-agent uninstall (or leave) removes them.
staged_ukis() {
	local d seen=" "
	for d in "$ESP" /boot/efi /efi /boot; do
		[[ -d $d/maclab ]] || continue
		d=$(readlink -f "$d/maclab")
		[[ $seen == *" $d "* ]] && continue
		seen+="$d "
		find "$d" -maxdepth 3 -type f -name '*.efi' 2>/dev/null || true
	done
	return 0
}

# yes, no or unreadable: whether a boot image's file list has the key file. The list is read in
# full first: a grep -q on the pipe would stop lsinitcpio early and pipefail would report a miss.
image_key() {
	local list
	list=$(lsinitcpio "$1" 2>/dev/null) || { echo unreadable; return 0; }
	if grep -qx "etc/cryptsetup-keys.d/$VOLUME.key" <<<"$list"; then echo yes; else echo no; fi
}

# yes, no or unreadable: whether a UKI's embedded command line has TOKEN.
uki_token() {
	local tmp line
	tmp=$(mktemp)
	if ! objcopy -O binary --only-section=.cmdline "$1" "$tmp" 2>/dev/null; then
		rm -f "$tmp"; echo unreadable; return 0
	fi
	line=$(tr '\0\n' '  ' <"$tmp"); rm -f "$tmp"
	if has_word "$line" "$TOKEN"; then echo yes; else echo no; fi
}

# The limine.conf entries that boot this Mac's UKIs, one "<entry>\t<state>" line each, where
# state is yes or no (the entry's own cmdline: has TOKEN or not) or none (no cmdline: line, so the
# UKI's embedded one applies). Snapshot entries and the maclab block are left out: those still
# ask for the passphrase. On an Omarchy Mac the entries carry their own cmdline: and systemd-stub
# boots that one, so the UKI's .cmdline alone doesn't say what boots.
limine_entries() {
	[[ -n $LIMINE_CONF && -r $LIMINE_CONF ]] || return 0
	TOK=$TOKEN UKI=$UKI_NAME awk '
		function flush(   st, d, full) {
			if (name != "" && !skip && path ~ ("/EFI/Linux/" uki "_[^/#]*\\.efi")) {
				gsub(/[[:space:]]+/, " ", cmd)
				st = !hascmd ? "none" : (index(" " cmd " ", " " tok " ") ? "yes" : "no")
				print name "\t" st
			}
			name = ""; path = ""; cmd = ""; hascmd = 0
		}
		BEGIN { tok = ENVIRON["TOK"]; uki = ENVIRON["UKI"] }
		/^[[:space:]]*# maclab: begin/ { flush(); inlab = 1; next }
		/^[[:space:]]*# maclab: end/ { flush(); inlab = 0; next }
		/^[[:space:]]*\// {
			flush()
			line = $0; sub(/^[[:space:]]*/, "", line)
			depth = match(line, /[^\/]/) - 1
			if (depth < 1) next
			label = substr(line, depth + 1); sub(/^\+/, "", label)
			names[depth] = label
			skip = inlab; name = ""
			for (d = 1; d <= depth; d++) {
				if (tolower(names[d]) ~ /snapshot/) skip = 1
				name = name (d > 1 ? " / " : "") names[d]
			}
			next
		}
		/^[[:space:]]*[A-Za-z_]+:/ {
			key = $0; sub(/^[[:space:]]*/, "", key); val = key
			sub(/:.*/, "", key); key = tolower(key); sub(/^[^:]*:[[:space:]]*/, "", val)
			if (key == "path" || key == "image_path" || key == "kernel_path") path = val
			else if (key == "cmdline" || key == "kernel_cmdline") { cmd = val; hascmd = 1 }
		}
		END { flush() }
	' "$LIMINE_CONF"
}

all_images_keyed() {
	local f e
	[[ -n $(ukis) ]] || return 1
	while read -r f; do
		[[ -z $f ]] || [[ $(image_key "$f") == yes && $(uki_token "$f") == yes ]] || return 1
	done < <(ukis)
	while read -r f; do
		[[ -z $f ]] || [[ $(image_key "$f") == yes ]] || return 1
	done < <(initramfs_images)
	e=$(limine_entries)
	[[ -n $e ]] || return 1
	! grep -q $'\tno$' <<<"$e"
}

has_word() { [[ " $1 " == *[[:space:]]"$2"[[:space:]]* ]]; }

# Whether a command-line line of CMDFILE holds TOKEN. (No grep -q at the end of a pipe: it can
# stop the first grep early, and pipefail then reports a miss.)
cmdfile_has_token() { grep -E "$CMDLINE_RE" "$CMDFILE" | grep -F -- "$TOKEN" >/dev/null; }

# Any other rd.luks.key= in CMDFILE's command line that applies to this volume: one for its UUID,
# or one without a UUID (which applies to every volume).
other_luks_keys() {
	{ grep -E "$CMDLINE_RE" "$CMDFILE" || true; } | tr -s " \t\"'" '\n' | { grep -E '^rd\.luks\.key=' || true; } |
		{ grep -vxF -- "$TOKEN" || true; } | { grep -iE "^rd\.luks\.key=(${UUID}=|[^0-9a-f])" || true; } | sort -u | paste -sd' '
}

# The entry for this volume in /etc/crypttab.initramfs, if any.
crypttab_entry() {
	[[ -r $CRYPTTAB ]] || return 0
	awk -v vol="$VOLUME" -v uuid="${UUID,,}" '!/^[[:space:]]*(#|$)/ { if ($1 == vol || index(tolower($2), uuid)) { print; exit } }' "$CRYPTTAB"
}

# The checks edit_cmdline makes, run before anything changes, so a refusal there can't come after
# the key slot is added or removed.
check_cmdfile() {
	local lines
	[[ -w $CMDFILE ]] || die "can't write $CMDFILE"
	if [[ $1 == add ]] && cmdfile_has_token; then return 0; fi
	if [[ $1 == remove ]] && ! cmdfile_has_token; then return 0; fi
	lines=$(grep -E "$CMDLINE_RE" "$CMDFILE" || true)
	if [[ $1 == add && -z $lines && $MODE != omarchy-mac ]]; then
		die "$CMDFILE has no command line to add to; nothing changed"
	fi
	if [[ -n $lines ]] && grep -vE '^[^"]*="[^"]*"[[:space:]]*$' <<<"$lines" >/dev/null; then
		die "$CMDFILE has a command line that isn't one plain double-quoted value; $1 \"$TOKEN\" there by hand, then run this again. Nothing changed"
	fi
}

# Whether users other than root can read file $1 (by its mode, or because a user owns it).
others_can_read() {
	local m o
	read -r m o < <(stat -c '%a %u' "$1")
	(( (8#$m & 8#044) || o != 0 ))
}

# Whether the ESP's FAT mount lets users other than root read its files: its fmask (or umask)
# leaves group or other read on. With neither set, vfat takes the mounter's umask, usually 022.
esp_open() {
	local fs opts mask
	read -r fs opts < <(findmnt -no FSTYPE,OPTIONS -T "$ESP/EFI/Linux") || return 1
	[[ $fs == vfat ]] || return 1
	mask=$(tr ',' '\n' <<<"$opts" | sed -n 's/^fmask=//p' | tail -1)
	[[ -n $mask ]] || mask=$(tr ',' '\n' <<<"$opts" | sed -n 's/^umask=//p' | tail -1)
	[[ -n $mask ]] || return 0
	(( (8#$mask & 8#044) != 8#044 ))
}

# Loud warnings for every boot image that holds the key and users other than root can read: lab
# jobs run their tools as the GUI user, so any of them could copy the key.
readable_warnings() {
	local f warned=0
	if esp_open; then
		say "WARNING: $ESP is mounted so that every user can read its files (fmask/umask leaves read on). The UKIs there hold the disk key while this is enabled, and lab jobs run tools as the GUI user. Mount it root-only: fmask=0077,dmask=0077 in /etc/fstab, then remount."
		warned=1
	fi
	while read -r f; do
		[[ -n $f && $(image_key "$f") == yes ]] || continue
		if others_can_read "$f"; then
			say "WARNING: $f holds the disk key and users other than root can read it ($(stat -c 'mode %a, owner %U' "$f"))."
			warned=1
		fi
	done < <(ukis; initramfs_images; staged_ukis)
	(( warned )) || return 0
}

# Copies the key file out of boot image $1 into the private folder and prints its path. From a
# UKI: its .initrd section (objcopy), then bsdcpio for just that file; else lsinitcpio -x of the
# whole image. Fails (returns 1) when neither works.
extract_key() {
	local dir rel=etc/cryptsetup-keys.d/$VOLUME.key
	dir=$(mktemp -d "$TMPD/x.XXXXXX") || return 1
	if command -v bsdcpio >/dev/null; then
		if [[ $1 == *.efi ]]; then
			if objcopy -O binary --only-section=.initrd "$1" "$dir/initrd" 2>/dev/null && [[ -s $dir/initrd ]]; then
				(cd "$dir" && bsdcpio -i -d --quiet "$rel" <initrd) >/dev/null 2>&1 || true
			fi
		else
			(cd "$dir" && bsdcpio -i -d --quiet "$rel" <"$1") >/dev/null 2>&1 || true
		fi
	fi
	if [[ ! -s $dir/$rel ]]; then
		(cd "$dir" && lsinitcpio -x "$1") >/dev/null 2>&1 || true
	fi
	[[ -f $dir/$rel && ! -L $dir/$rel && -s $dir/$rel ]] || return 1
	chmod 600 "$dir/$rel"
	printf '%s\n' "$dir/$rel"
}

# Says which pbkdf2/1000 slots nothing here opens and how to remove one, then exits 1. Slots given
# are left out.
report_orphans() {
	orphan_slots "$@"
	(( ${#ORPHANS[@]} )) || return 0
	say "Key slots ${ORPHANS[*]} use pbkdf2 with 1000 iterations, as this script's do, but nothing on this"
	say "Mac opens them: most likely an old auto-unlock key (from a snapshot restored after enable, or a"
	say "key file deleted by hand). Anyone who kept a copy of that key could still open the disk."
	(( ${#KEEP[@]} )) && say "The owner's and recovery slots ($STATE) are ${KEEP[*]}."
	say "To remove one you are sure of:"
	say "  cryptsetup luksKillSlot $DEVICE <slot>   (asks for a passphrase that opens another slot)"
	say "then run this again."
	exit 1
}

confirm() {
	(( YES )) && return 0
	local typed
	{ : </dev/tty; } 2>/dev/null || die "needs a terminal to confirm (or pass --yes)"
	printf '\nType "yes" to %s lab-only auto-unlock on %s: ' "$1" "$(uname -n)" >/dev/tty
	read -r typed </dev/tty
	[[ $typed == yes ]] || die "not confirmed; nothing changed"
}

need_tty() { { : </dev/tty; } 2>/dev/null || die "cryptsetup needs a terminal to ask for the disk passphrase"; }

backup() {
	local dest
	install -d -m 700 "$BACKUPS"
	dest=$(mktemp "$BACKUPS/$(basename "$1").$(date +%Y%m%d-%H%M%S).XXXX")
	cp -a "$1" "$dest"
	say "Backed up $1 to $dest"
}

# Adds TOKEN to (add) or removes it from (remove) the kernel command line in CMDFILE. It edits only
# the quoted value of the lines CMDLINE_RE matches: on add, the last one (whose value the tools
# take, or append to); on remove, every one holding it. Other text stays byte for byte.
edit_cmdline() {
	local tmp
	if [[ $1 == add ]] && cmdfile_has_token; then return 0; fi
	if [[ $1 == remove ]] && ! cmdfile_has_token; then return 0; fi
	if [[ $1 == add ]] && ! grep -qE "$CMDLINE_RE" "$CMDFILE"; then
		[[ $MODE == omarchy-mac ]] || die "$CMDFILE has no command line to add to"
	fi
	if grep -E "$CMDLINE_RE" "$CMDFILE" | grep -vE '^[^"]*="[^"]*"[[:space:]]*$' >/dev/null; then
		die "$CMDFILE has a command line that isn't one plain double-quoted value; $1 \"$TOKEN\" there by hand"
	fi
	backup "$CMDFILE"
	tmp=$(mktemp "$CMDFILE.XXXXXX")
	# Through the environment, not awk -v, which would eat the backslashes in the regex.
	RE=$CMDLINE_RE TOK=$TOKEN OP=$1 MAC=$([[ $MODE == omarchy-mac ]] && echo 1 || true) awk '
		BEGIN { re = ENVIRON["RE"]; tok = ENVIRON["TOK"]; op = ENVIRON["OP"]; mac = ENVIRON["MAC"] }
		NR == FNR { if ($0 ~ re) last = FNR; next }
		$0 ~ re && (op == "add" ? FNR == last : index($0, tok) > 0) {
			q = index($0, "\""); pre = substr($0, 1, q); rest = substr($0, q + 1)
			q = index(rest, "\""); val = substr(rest, 1, q - 1); post = substr(rest, q)
			if (op == "add") {
				val = (val ~ /[^ \t]$/) ? val " " tok : val tok
			} else {
				# Drop each whole-word copy and the space before it; nothing else moves.
				val = " " val " "
				while ((i = index(val, " " tok " ")) > 0) val = substr(val, 1, i) substr(val, i + length(tok) + 2)
				sub(/^ /, "", val); sub(/ $/, "", val)
			}
			print pre val post; next
		}
		{ print }
		END { if (op == "add" && !last && mac) print "GRUB_CMDLINE_LINUX=\"" tok "\"" }
	' "$CMDFILE" "$CMDFILE" >"$tmp" || { rm -f "$tmp"; die "couldn't edit $CMDFILE"; }
	chmod --reference="$CMDFILE" "$tmp"; chown --reference="$CMDFILE" "$tmp"
	mv -f "$tmp" "$CMDFILE"
	if [[ $1 == add ]]; then
		cmdfile_has_token || die "$TOKEN didn't make it into $CMDFILE"
	else
		! cmdfile_has_token || die "$TOKEN is still in $CMDFILE"
	fi
	say "$([[ $1 == add ]] && echo Added || echo Removed) $TOKEN $([[ $1 == add ]] && echo in || echo from) $CMDFILE"
}

need_rebuild_tools() {
	[[ -z $(initramfs_images) || -x /usr/bin/mkinitcpio ]] || die "/boot holds initramfs images but there is no /usr/bin/mkinitcpio to rebuild them; nothing changed"
	command -v "$REBUILD" >/dev/null || die "no $REBUILD to rebuild the boot images; nothing changed"
}

rebuild() {
	# Initramfs images in /boot get the same treatment, so no image is left behind. mkinitcpio
	# goes first and the Limine tools last, so the UKIs Limine boots are theirs.
	if [[ -n $(initramfs_images) ]]; then
		say "Rebuilding the initramfs images in /boot (mkinitcpio -P)..."
		/usr/bin/mkinitcpio -P || die "mkinitcpio -P failed; run status"
	fi
	say "Rebuilding the boot images ($REBUILD)..."
	"$REBUILD" || die "$REBUILD failed; run status"
}

# ---- status ----------------------------------------------------------------------------------

status() {
	local f s slots n k t e other=() ct ok
	probe_key
	slots=$(keyslots)
	n=$(grep -c . <<<"$slots") || true
	say "root: LUKS2 $DEVICE (UUID $UUID), volume $VOLUME; command line from $CMDFILE ($MODE)"
	say "key slots: $(paste -sd' ' <<<"$slots")${KEEP[*]:+ (kept, from $STATE: ${KEEP[*]})}"
	if [[ -f $KEY ]]; then
		if [[ -n $KEY_SLOT ]]; then
			say "key file: $KEY ($(stat -c '%s bytes, mode %a, owner %U' "$KEY")), opens key slot $KEY_SLOT"
			kept "$KEY_SLOT" && say "CONFLICT: that is the owner's or recovery slot ($STATE); enable and disable will refuse"
			(( n > 1 )) || say "WARNING: it is the only key slot; disable will refuse until another one is added"
		else
			say "key file: $KEY, DEAD: it opens no key slot (disable cleans it up; enable replaces it)"
		fi
	else
		say "key file: none"
	fi
	if (( ${#KEEP[@]} )); then
		while read -r s; do
			[[ -z $s ]] || kept "$s" || [[ $s == "${KEY_SLOT:-}" ]] || other+=("$s")
		done <<<"$slots"
		say "other key slots: ${other[*]:-none}$( (( ${#other[@]} )) && echo ' (neither kept nor opened by the key file: an old key from a restored snapshot? cryptsetup luksKillSlot removes one you are sure of)')"
	fi
	# With or without encrypt.state: slots made like this script's that the key file doesn't open.
	orphan_slots "${KEY_SLOT:-}"
	if (( ${#ORPHANS[@]} )); then
		say "UNEXPLAINED key slots: ${ORPHANS[*]} use pbkdf2 with 1000 iterations, as this script's do, but the key file doesn't open them (an old auto-unlock key? disable removes it when a boot image still holds its key; otherwise cryptsetup luksKillSlot $DEVICE <slot>)"
	fi
	if [[ -f $DROPIN ]]; then say "drop-in: $DROPIN: $(tr '\n' ' ' <"$DROPIN")"; else say "drop-in: none"; fi
	if cmdfile_has_token; then say "command line: $CMDFILE has $TOKEN"; else say "command line: $CMDFILE has no $TOKEN"; fi
	e=$(other_luks_keys)
	[[ -z $e ]] || say "command line: $CMDFILE also has $e (enable refuses while it is there)"
	ct=$(crypttab_entry)
	[[ -z $ct ]] || say "crypttab: $CRYPTTAB has an entry for this volume: $ct (enable refuses while it is there)"
	if has_word "$(cat /proc/cmdline)" "$TOKEN"; then say "running boot: booted with it"; else say "running boot: booted without it"; fi
	while read -r f; do
		[[ -n $f ]] || continue
		k=$(image_key "$f") t=$(uki_token "$f")
		say "UKI $f: key file $k, $TOKEN on its command line $t$([[ $k == yes && -z $KEY_SLOT ]] && echo ' (a DEAD key, unless it is the one in an unexplained slot)')"
	done < <(ukis)
	while read -r f; do
		[[ -n $f ]] || continue
		k=$(image_key "$f")
		say "image $f: key file $k$([[ $k == yes && -z $KEY_SLOT ]] && echo ' (a DEAD key, unless it is the one in an unexplained slot)')"
	done < <(initramfs_images)
	while read -r f; do
		[[ -n $f ]] || continue
		say "lab boot UKI $f (staged by lab-agent): key file $(image_key "$f")"
	done < <(staged_ukis)
	if [[ -z $LIMINE_CONF ]]; then
		say "boot menu: no limine.conf found on $ESP"
	else
		e=$(limine_entries)
		[[ -n $e ]] || say "boot menu: no entry in $LIMINE_CONF boots ${UKI_NAME}_*.efi"
		while IFS=$'\t' read -r f ok; do
			[[ -n $f ]] || continue
			case $ok in
				none) say "boot entry \"$f\" ($LIMINE_CONF): no cmdline of its own, boots the UKI's" ;;
				*) say "boot entry \"$f\" ($LIMINE_CONF): $TOKEN on its cmdline $ok" ;;
			esac
		done <<<"$e"
	fi
	readable_warnings
}

# ---- enable ----------------------------------------------------------------------------------

enable() {
	local tmp f e ok bad=0 header line="FILES+=($KEY)"
	probe_key
	refuse_kept
	if [[ -n $KEY_SLOT && -f $DROPIN && $(cat "$DROPIN") == "$line" ]] && cmdfile_has_token && all_images_keyed; then
		say "Already enabled: the key file opens key slot $KEY_SLOT and every boot image and entry has it. Nothing to do."
		readable_warnings
		return 0
	fi

	# Every refusal comes here, before the confirmation and before a key slot is added, so a
	# refused enable leaves nothing behind.
	e=$(crypttab_entry)
	[[ -z $e ]] || die "$CRYPTTAB has an entry for this volume ($e). The initramfs would take its options from there; this script only handles rd.luks.* on the kernel command line. Nothing changed"
	e=$(other_luks_keys)
	[[ -z $e ]] || die "$CMDFILE already has $e for this volume; remove it (or set this up by hand) first. Nothing changed"
	check_cmdfile add
	need_rebuild_tools
	[[ -n $LIMINE_CONF ]] || die "no limine.conf on $ESP, so there is no way to check what boots; nothing changed"
	[[ -n $KEY_SLOT ]] || need_tty

	cat <<EOF

  ==========================================================================================
   LAB-ONLY AUTO-UNLOCK. While it is enabled, ANYONE WHO HOLDS THIS MAC CAN READ ITS DISK:
   the disk key sits inside the boot images on the unencrypted EFI partition.

   Only for a Lab-owned Mac, a fresh lab-only install with nothing personal on it, or a
   lab-only install a Volunteer lends the lab and has explicitly agreed to this. Never on
   an install a Volunteer uses for anything of their own.

   Lab jobs run tools as the GUI user: keep the EFI partition readable by root only.
   disable protects the disk from whoever has the Mac after it; it can't take back what
   anyone who had the Mac while this was enabled could have copied.

   Restoring a Snapper snapshot taken while this is enabled brings the key file back:
   run disable again after such a restore. When the Mac leaves the lab: lab-agent
   uninstall (or leave), then: sudo scripts/$PROG disable
  ==========================================================================================
EOF
	readable_warnings
	confirm enable

	if [[ -z $KEY_SLOT ]]; then
		install -d -m 700 "$BACKUPS"
		header=$BACKUPS/luks-header-$VOLUME-$(date +%Y%m%d-%H%M%S).img
		(umask 077; cryptsetup luksHeaderBackup "$DEVICE" --header-backup-file "$header")
		say "Saved the LUKS header to $header. Copy it off this Mac and keep it private."
		install -d -m 700 "$KEYDIR"
		# Any key file here opens nothing (probe_key said so), so a new one can replace it.
		tmp=$(umask 077; mktemp "$KEYDIR/.key.XXXXXX")
		head -c 64 /dev/urandom >"$tmp"
		[[ $(stat -c %s "$tmp") == 64 ]] || { rm -f "$tmp"; die "couldn't write a 64-byte key"; }
		chown root:root "$tmp"; chmod 600 "$tmp"
		mv -f "$tmp" "$KEY"
		say "Adding a key slot for $KEY. cryptsetup asks for your existing disk passphrase."
		cryptsetup luksAddKey --pbkdf pbkdf2 --pbkdf-force-iterations 1000 "$DEVICE" "$KEY" </dev/tty
		probe_key
		[[ -n $KEY_SLOT ]] || die "the new key doesn't open the disk; run status, then disable"
		say "The key opens key slot $KEY_SLOT."
	else
		say "The key file already opens key slot $KEY_SLOT."
	fi
	refuse_kept

	if [[ ! -f $DROPIN || $(cat "$DROPIN") != "$line" ]]; then
		printf '%s\n' "$line" >"$DROPIN"
		chmod 644 "$DROPIN"
		say "Wrote $DROPIN"
	fi
	edit_cmdline add
	rebuild

	[[ -n $(ukis) ]] || die "no UKI in $ESP/EFI/Linux matches ${UKI_NAME}_*.efi after the rebuild"
	while read -r f; do
		[[ -n $f ]] || continue
		if [[ $(image_key "$f") == yes && $(uki_token "$f") == yes ]]; then
			say "UKI $f: has the key and $TOKEN"
		else
			say "UKI $f: MISSING the key ($(image_key "$f")) or $TOKEN ($(uki_token "$f")); that entry asks for the passphrase"; bad=1
		fi
	done < <(ukis)
	while read -r f; do
		[[ -n $f ]] || continue
		if [[ $(image_key "$f") == yes ]]; then say "image $f: has the key"; else say "image $f: MISSING the key"; bad=1; fi
	done < <(initramfs_images)
	# The command line that boots: an entry's own cmdline: wins over the UKI's embedded one.
	e=$(limine_entries)
	[[ -n $e ]] || { say "boot menu: no entry in $LIMINE_CONF boots ${UKI_NAME}_*.efi, so this can't check what boots"; bad=1; }
	while IFS=$'\t' read -r f ok; do
		[[ -n $f ]] || continue
		case $ok in
			yes) say "boot entry \"$f\": has $TOKEN on its cmdline" ;;
			none) say "boot entry \"$f\": no cmdline of its own, boots the UKI's (checked above)" ;;
			*) say "boot entry \"$f\": its cmdline in $LIMINE_CONF has no $TOKEN; that entry asks for the passphrase"; bad=1 ;;
		esac
	done <<<"$e"
	probe_key
	[[ -n $KEY_SLOT ]] || die "the key file no longer opens the disk; run status"
	(( !bad )) || die "not every boot image or entry has the key; run status (disable undoes it all)"
	readable_warnings
	say "Enabled: key slot $KEY_SLOT, in every boot image and entry. Reboot: there should be no passphrase prompt."
	say "Then lab-agent preflight should no longer report the disk as encrypted."
}

# ---- disable ---------------------------------------------------------------------------------

disable() {
	local f k e ok cand s r out slot slots n leftover=0 keyed=() tokened=() failed=() remove=() rslots=()
	probe_key
	refuse_kept

	# Every way this Mac could still unlock without the passphrase, before deciding anything.
	while read -r f; do
		[[ -n $f ]] || continue
		[[ $(image_key "$f") != yes ]] || die "$f, a lab boot image lab-agent staged, holds the key. Take the lab off first: sudo lab-agent uninstall (or, on a Volunteer's Mac, leave) removes those images; then run disable again. Nothing changed"
	done < <(staged_ukis)
	while read -r f; do
		[[ -n $f ]] || continue
		[[ $(image_key "$f") == no ]] || keyed+=("$f")
		[[ $f != *.efi || $(uki_token "$f") == no ]] || tokened+=("$f")
	done < <(ukis; initramfs_images)
	e=$(limine_entries)
	while IFS=$'\t' read -r f ok; do
		[[ -n $f && $ok == yes ]] && tokened+=("boot entry \"$f\"")
	done <<<"$e"

	# The key file opens a slot: that is the one to remove. When it doesn't (it is gone, or a
	# restored snapshot swapped it), a boot image can still hold a key that opens one: copy each
	# out and use it.
	if [[ -n $KEY_SLOT ]]; then
		remove+=("$KEY_SLOT:$KEY"); rslots+=("$KEY_SLOT")
	else
		for f in "${keyed[@]}"; do
			[[ $(image_key "$f") == yes ]] || continue
			make_tmpd
			if ! cand=$(extract_key "$f"); then failed+=("$f"); continue; fi
			probe_file "$cand"
			if [[ -z $PROBED ]]; then say "$f holds a dead key: it opens no key slot."; continue; fi
			kept "$PROBED" && die "the key in $f opens key slot $PROBED, which $STATE records as the owner's or recovery slot; nothing changed"
			[[ " ${rslots[*]} " == *" $PROBED "* ]] && continue
			say "$f holds a key that still opens key slot $PROBED (the key file doesn't); disable removes that slot with it."
			remove+=("$PROBED:$cand"); rslots+=("$PROBED")
		done
		if (( ${#failed[@]} )); then
			orphan_slots "${rslots[@]}"
			if (( ${#ORPHANS[@]} )); then
				say "${failed[*]} hold(s) a key file this couldn't copy out (no bsdcpio, or lsinitcpio -x failed),"
				say "so this can't tell which key slot it opens. Slots that look like this script's (pbkdf2,"
				say "1000 iterations; passphrase slots use argon2id): ${ORPHANS[*]}."
				(( ${#KEEP[@]} )) && say "The owner's and recovery slots ($STATE) are ${KEEP[*]}: never those."
				say "  cryptsetup luksDump $DEVICE                              shows each slot's PBKDF"
				say "  cryptsetup open --test-passphrase --verbose $DEVICE     shows the slot your passphrase opens"
				say "  cryptsetup luksKillSlot $DEVICE <slot>                  removes the auto-unlock slot"
				die "nothing changed; remove the auto-unlock slot as above, then run disable again"
			fi
			say "${failed[*]}: couldn't copy the key out, but no key slot looks like this script's (pbkdf2, 1000 iterations), so going on to clear the images."
		fi
	fi

	if (( ${#remove[@]} == 0 && ${#keyed[@]} == 0 && ${#tokened[@]} == 0 )) && [[ ! -e $DROPIN && ! -e $KEY ]] && ! cmdfile_has_token; then
		report_orphans
		say "Already disabled: no key slot opened by $KEY or by a boot image, no key file, drop-in or $TOKEN in $CMDFILE, and no boot image or entry holds the key or $TOKEN."
		return 0
	fi

	# Every refusal before the confirmation and before anything changes.
	if (( ${#remove[@]} )); then
		slots=$(keyslots)
		n=$(grep -c . <<<"$slots") || true
		if (( n <= ${#remove[@]} )); then
			[[ -n $KEY_SLOT ]] && die "the key file opens key slot $KEY_SLOT, the only key slot: removing it would lock the disk for good. Add a passphrase first (cryptsetup luksAddKey --key-file $KEY $DEVICE), then run disable again"
			die "key slots ${rslots[*]} are the only ones: removing them would lock the disk for good. Add a passphrase first (cryptsetup luksAddKey $DEVICE), then run disable again"
		fi
		need_tty
	fi
	check_cmdfile remove
	need_rebuild_tools
	confirm disable

	# The key slots go first, so the copies of the key on this Mac (boot images, snapshots,
	# backups) open nothing. Before that, prove another slot still opens the disk.
	if (( ${#remove[@]} )); then
		say "Type your disk passphrase, to check it still opens the disk once key slot(s) ${rslots[*]} are gone."
		out=$(cryptsetup open --test-passphrase --verbose --token-type passphrase-only "$DEVICE" </dev/tty) || die "that passphrase doesn't open the disk; nothing changed"
		slot=$(grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1) || true
		[[ -n $slot && " ${rslots[*]} " != *" $slot "* ]] || die "couldn't confirm the passphrase opens a slot other than ${rslots[*]}; nothing changed"
		for r in "${remove[@]}"; do
			s=${r%%:*} cand=${r#*:}
			cryptsetup luksRemoveKey "$DEVICE" "$cand"
			probe_file "$cand"
			[[ -z $PROBED ]] || die "the key still opens key slot $PROBED (the same key was in two slots); run disable again"
			say "Removed key slot $s."
		done
		say "The passphrase in slot $slot opens the disk."
		probe_key
	fi
	# Only now, with cryptsetup saying the key opens nothing, do the key file and the rest go.
	rm -f "$KEY" "$DROPIN"
	edit_cmdline remove
	rebuild

	while read -r f; do
		[[ -n $f ]] || continue
		case $(image_key "$f") in
			no) ;;
			yes) say "image $f still contains a key file (it no longer opens the disk)"; leftover=1 ;;
			*) say "image $f: couldn't read it to check"; leftover=1 ;;
		esac
		[[ $f != *.efi || $(uki_token "$f") == no ]] || { say "UKI $f still has $TOKEN on its command line"; leftover=1; }
	done < <(ukis; initramfs_images)
	e=$(limine_entries)
	while IFS=$'\t' read -r f ok; do
		[[ -n $f && $ok == yes ]] || continue
		say "boot entry \"$f\" in $LIMINE_CONF still has $TOKEN on its cmdline"; leftover=1
	done <<<"$e"
	slots=$(keyslots)
	say "key slots now: $(paste -sd' ' <<<"$slots")"
	(( !leftover )) || die "something is left over; run status"
	report_orphans
	say "Disabled. Reboot: the passphrase prompt is back."
	say "If you restore a Snapper snapshot taken while this was enabled, run disable again."
	say "This protects the disk from whoever has the Mac from now on. It doesn't change the volume key: if"
	say "the Mac was out of your hands while this was enabled, reinstall or run cryptsetup reencrypt."
}

# ---- main ------------------------------------------------------------------------------------

CMD='' YES=0
for a in "$@"; do
	case $a in
		--yes) YES=1 ;;
		status|enable|disable) [[ -z $CMD ]] || die "one command at a time"; CMD=$a ;;
		*) die "usage: sudo $0 {status|enable|disable} [--yes]" ;;
	esac
done
[[ -n $CMD ]] || die "usage: sudo $0 {status|enable|disable} [--yes]"
(( EUID == 0 )) || die "run it as root (sudo)"
check_layout
"$CMD"
